# Copy to .env and fill in. .env is gitignored — never commit real keys.
# The fetch-* npm scripts load .env automatically; they still run without it
# (fetch-lyrics exits with a message, fetch-covers falls back to MusicBrainz).

# https://genius.com/api-clients — npm run fetch-lyrics
GENIUS_ACCESS_TOKEN=

# https://www.last.fm/api/account/create — npm run fetch-covers (legacy fallback)
LASTFM_API_KEY=

# Google Cloud console, YouTube Data API v3 — npm run fetch-youtube-ids
# Free tier is 100 searches/day.
YOUTUBE_API_KEY=
